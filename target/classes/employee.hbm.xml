<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
	
	<hibernate-mapping>
	
	<class name="com.hbn.entity.Employee" table="emp">   <!--table="emp" is used to create table name as our wish -->
	
	<!--assign is a default generator that add NOT NULL & PRIMARY KEY constraint.
	identity is also a generator used for auto increament-->
	<id name="id"><generator class="identity"></generator> </id>
	<property name="name" column="emp_name"> </property>   <!--column="emp_name" is used to create coulmn name as our wish -->
	<property name="gender"> </property>
	<property name="salary"> </property>
	
	</class>
	
	</hibernate-mapping>